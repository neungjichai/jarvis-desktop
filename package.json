{
  "name": "jarvis-desktop",
  "productName": "HeyJarvis",
  "version": "0.1.0",
  "description": "비서 자비스 - 작업 표시줄 위를 걷는 데스크톱 캐릭터 비서",
  "main": "src/main/main.js",
  "author": "헤이 자비스",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.heyjarvis.desktop",
    "productName": "HeyJarvis",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "HeyJarvis-Setup-${version}.${ext}",
      "oneClick": true
    }
  }
}
